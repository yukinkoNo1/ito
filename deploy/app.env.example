# アプリ用の設定と秘密情報（deploy/app.env にコピーして使う。権限 600、git には入れない。SPEC 付録A）
# NODE_ENV・HOST・PORT・DATABASE_PATH・BACKUP_DIR は compose.yaml で指定している

# 公開オリジン（Origin・Host 検査に使う）
APP_ORIGIN=https://ito.tail1234.ts.net
AUTH_MODE=tailscale
# 初回アクセス時に管理者として登録するログイン（カンマ区切り）
ADMIN_LOGINS=you@example.com
MAX_MEMBERS=6

# 一言入力の AI 解析。未設定ならルール解析だけ
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
AI_TIMEOUT_MS=6000
AI_RATE_PER_MIN=20
AI_RATE_PER_DAY=200

# Web Push（npx web-push generate-vapid-keys で作成）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: か https: の正しい形式で（形式が不正だと Apple の Push が拒否する）
VAPID_SUBJECT=mailto:you@example.com

BACKUP_KEEP=14
# いえボードが人の PC で動いている間だけ true（SPEC §13.1・§18 T16）
FEED_ALLOW_USER_DEVICES=false
LOG_LEVEL=info
