# 開発用の設定（秘密情報は入れない。VAPID の開発用の鍵などは .data/dev.secrets.env に置く＝.gitignore 済み）
NODE_ENV=development
AUTH_MODE=dev
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://localhost:5173
DEV_LOGIN=papa@example.com
ADMIN_LOGINS=papa@example.com
DATABASE_PATH=../../.data/dev/ito.db
BACKUP_DIR=../../.data/dev/backups
ANTHROPIC_API_KEY=
LOG_LEVEL=info
