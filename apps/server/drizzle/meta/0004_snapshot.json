        "events_shape": {
          "name": "events_shape",
          "value": "(all_day = 1 AND start_date IS NOT NULL AND end_date IS NOT NULL AND start_at IS NULL AND end_at IS NULL) OR (all_day = 0 AND start_at IS NOT NULL AND start_date IS NULL AND end_date IS NULL)"
